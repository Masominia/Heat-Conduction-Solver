# The same device on three meshes that all place cell faces on its interfaces.
# Reference: the same mesh solved with a sparse direct solver in SciPy. The pipeline reports the change between meshes.
title Standard shifter on a 125 nm mesh
grid dx=0.125 dy=0.125
window width=40 ymin=-10 ymax=5
layer si -10 0
layer sio2 0 5
rect si -0.25 0.25 2 2.25
rect tin -1 1 4 4.25
heater h xmin=-1 xmax=1 ymin=4 ymax=4.25 power=0.1
probe wg xmin=-0.25 xmax=0.25 ymin=2 ymax=2.25
expect response wg h 171.292936 1e-7
expect pi_power wg h 24.3248015 1e-7
expect peak 41.0836337 1e-7
expect balance 1e-9
expect cells 38400
