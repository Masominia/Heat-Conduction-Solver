# The same system solved by preconditioned conjugate gradients, not by factorisation.
# Reference: the sparse direct solution; the two solvers must agree to 1e-7.
title Conjugate gradients: array
grid dx=0.25 dy=0.25
window width=80 ymin=-10 ymax=5
layer si -10 0
layer sio2 0 5
rect si -17.75 -17.25 2 2.25
rect tin -18.5 -16.5 4 4.25
heater h1 xmin=-18.5 xmax=-16.5 ymin=4 ymax=4.25 power=0.1
probe w1 xmin=-17.75 xmax=-17.25 ymin=2 ymax=2.25
rect si -12.75 -12.25 2 2.25
rect tin -13.5 -11.5 4 4.25
heater h2 xmin=-13.5 xmax=-11.5 ymin=4 ymax=4.25 power=0
probe w2 xmin=-12.75 xmax=-12.25 ymin=2 ymax=2.25
rect si -7.75 -7.25 2 2.25
rect tin -8.5 -6.5 4 4.25
heater h3 xmin=-8.5 xmax=-6.5 ymin=4 ymax=4.25 power=0.1
probe w3 xmin=-7.75 xmax=-7.25 ymin=2 ymax=2.25
rect si -2.75 -2.25 2 2.25
rect tin -3.5 -1.5 4 4.25
heater h4 xmin=-3.5 xmax=-1.5 ymin=4 ymax=4.25 power=0
probe w4 xmin=-2.75 xmax=-2.25 ymin=2 ymax=2.25
rect si 2.25 2.75 2 2.25
rect tin 1.5 3.5 4 4.25
heater h5 xmin=1.5 xmax=3.5 ymin=4 ymax=4.25 power=0.1
probe w5 xmin=2.25 xmax=2.75 ymin=2 ymax=2.25
rect si 7.25 7.75 2 2.25
rect tin 6.5 8.5 4 4.25
heater h6 xmin=6.5 xmax=8.5 ymin=4 ymax=4.25 power=0
probe w6 xmin=7.25 xmax=7.75 ymin=2 ymax=2.25
rect si 12.25 12.75 2 2.25
rect tin 11.5 13.5 4 4.25
heater h7 xmin=11.5 xmax=13.5 ymin=4 ymax=4.25 power=0.1
probe w7 xmin=12.25 xmax=12.75 ymin=2 ymax=2.25
rect si 17.25 17.75 2 2.25
rect tin 16.5 18.5 4 4.25
heater h8 xmin=16.5 xmax=18.5 ymin=4 ymax=4.25 power=0
probe w8 xmin=17.25 xmax=17.75 ymin=2 ymax=2.25
solver cg
expect response w1 h1 169.754909 1e-7
