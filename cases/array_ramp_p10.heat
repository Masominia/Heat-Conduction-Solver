# The same ramp at twice the pitch: the temperatures follow the powers more faithfully. Temperatures are the sum of the responses to each heater.
# Reference: the same mesh solved with a sparse direct solver in SciPy.
title Array of 8 at 10 um pitch, linear power ramp
grid dx=0.25 dy=0.25
window width=120 ymin=-10 ymax=5
layer si -10 0
layer sio2 0 5
rect si -35.25 -34.75 2 2.25
rect tin -36 -34 4 4.25
heater h1 xmin=-36 xmax=-34 ymin=4 ymax=4.25 power=0
probe w1 xmin=-35.25 xmax=-34.75 ymin=2 ymax=2.25
rect si -25.25 -24.75 2 2.25
rect tin -26 -24 4 4.25
heater h2 xmin=-26 xmax=-24 ymin=4 ymax=4.25 power=0.02
probe w2 xmin=-25.25 xmax=-24.75 ymin=2 ymax=2.25
rect si -15.25 -14.75 2 2.25
rect tin -16 -14 4 4.25
heater h3 xmin=-16 xmax=-14 ymin=4 ymax=4.25 power=0.04
probe w3 xmin=-15.25 xmax=-14.75 ymin=2 ymax=2.25
rect si -5.25 -4.75 2 2.25
rect tin -6 -4 4 4.25
heater h4 xmin=-6 xmax=-4 ymin=4 ymax=4.25 power=0.06
probe w4 xmin=-5.25 xmax=-4.75 ymin=2 ymax=2.25
rect si 4.75 5.25 2 2.25
rect tin 4 6 4 4.25
heater h5 xmin=4 xmax=6 ymin=4 ymax=4.25 power=0.08
probe w5 xmin=4.75 xmax=5.25 ymin=2 ymax=2.25
rect si 14.75 15.25 2 2.25
rect tin 14 16 4 4.25
heater h6 xmin=14 xmax=16 ymin=4 ymax=4.25 power=0.1
probe w6 xmin=14.75 xmax=15.25 ymin=2 ymax=2.25
rect si 24.75 25.25 2 2.25
rect tin 24 26 4 4.25
heater h7 xmin=24 xmax=26 ymin=4 ymax=4.25 power=0.12
probe w7 xmin=24.75 xmax=25.25 ymin=2 ymax=2.25
rect si 34.75 35.25 2 2.25
rect tin 34 36 4 4.25
heater h8 xmin=34 xmax=36 ymin=4 ymax=4.25 power=0.14
probe w8 xmin=34.75 xmax=35.25 ymin=2 ymax=2.25
expect response w1 h1 171.756478 1e-7
expect response w1 h2 13.4753807 1e-7
expect response w1 h3 0.92877945 1e-7
expect response w1 h4 0.101434157 1e-7
