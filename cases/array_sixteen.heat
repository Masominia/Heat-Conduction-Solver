# A sawtooth, as for a wrapped phase ramp: crosstalk rounds the teeth. Temperatures are the sum of the responses to each heater.
# Reference: the same mesh solved with a sparse direct solver in SciPy.
title Array of 16 at 4 um pitch, sawtooth of powers
grid dx=0.25 dy=0.25
window width=104 ymin=-10 ymax=5
layer si -10 0
layer sio2 0 5
rect si -30.25 -29.75 2 2.25
rect tin -31 -29 4 4.25
heater h1 xmin=-31 xmax=-29 ymin=4 ymax=4.25 power=0
probe w1 xmin=-30.25 xmax=-29.75 ymin=2 ymax=2.25
rect si -26.25 -25.75 2 2.25
rect tin -27 -25 4 4.25
heater h2 xmin=-27 xmax=-25 ymin=4 ymax=4.25 power=0.03
probe w2 xmin=-26.25 xmax=-25.75 ymin=2 ymax=2.25
rect si -22.25 -21.75 2 2.25
rect tin -23 -21 4 4.25
heater h3 xmin=-23 xmax=-21 ymin=4 ymax=4.25 power=0.06
probe w3 xmin=-22.25 xmax=-21.75 ymin=2 ymax=2.25
rect si -18.25 -17.75 2 2.25
rect tin -19 -17 4 4.25
heater h4 xmin=-19 xmax=-17 ymin=4 ymax=4.25 power=0.09
probe w4 xmin=-18.25 xmax=-17.75 ymin=2 ymax=2.25
rect si -14.25 -13.75 2 2.25
rect tin -15 -13 4 4.25
heater h5 xmin=-15 xmax=-13 ymin=4 ymax=4.25 power=0
probe w5 xmin=-14.25 xmax=-13.75 ymin=2 ymax=2.25
rect si -10.25 -9.75 2 2.25
rect tin -11 -9 4 4.25
heater h6 xmin=-11 xmax=-9 ymin=4 ymax=4.25 power=0.03
probe w6 xmin=-10.25 xmax=-9.75 ymin=2 ymax=2.25
rect si -6.25 -5.75 2 2.25
rect tin -7 -5 4 4.25
heater h7 xmin=-7 xmax=-5 ymin=4 ymax=4.25 power=0.06
probe w7 xmin=-6.25 xmax=-5.75 ymin=2 ymax=2.25
rect si -2.25 -1.75 2 2.25
rect tin -3 -1 4 4.25
heater h8 xmin=-3 xmax=-1 ymin=4 ymax=4.25 power=0.09
probe w8 xmin=-2.25 xmax=-1.75 ymin=2 ymax=2.25
rect si 1.75 2.25 2 2.25
rect tin 1 3 4 4.25
heater h9 xmin=1 xmax=3 ymin=4 ymax=4.25 power=0
probe w9 xmin=1.75 xmax=2.25 ymin=2 ymax=2.25
rect si 5.75 6.25 2 2.25
rect tin 5 7 4 4.25
heater h10 xmin=5 xmax=7 ymin=4 ymax=4.25 power=0.03
probe w10 xmin=5.75 xmax=6.25 ymin=2 ymax=2.25
rect si 9.75 10.25 2 2.25
rect tin 9 11 4 4.25
heater h11 xmin=9 xmax=11 ymin=4 ymax=4.25 power=0.06
probe w11 xmin=9.75 xmax=10.25 ymin=2 ymax=2.25
rect si 13.75 14.25 2 2.25
rect tin 13 15 4 4.25
heater h12 xmin=13 xmax=15 ymin=4 ymax=4.25 power=0.09
probe w12 xmin=13.75 xmax=14.25 ymin=2 ymax=2.25
rect si 17.75 18.25 2 2.25
rect tin 17 19 4 4.25
heater h13 xmin=17 xmax=19 ymin=4 ymax=4.25 power=0
probe w13 xmin=17.75 xmax=18.25 ymin=2 ymax=2.25
rect si 21.75 22.25 2 2.25
rect tin 21 23 4 4.25
heater h14 xmin=21 xmax=23 ymin=4 ymax=4.25 power=0.03
probe w14 xmin=21.75 xmax=22.25 ymin=2 ymax=2.25
rect si 25.75 26.25 2 2.25
rect tin 25 27 4 4.25
heater h15 xmin=25 xmax=27 ymin=4 ymax=4.25 power=0.06
probe w15 xmin=25.75 xmax=26.25 ymin=2 ymax=2.25
rect si 29.75 30.25 2 2.25
rect tin 29 31 4 4.25
heater h16 xmin=29 xmax=31 ymin=4 ymax=4.25 power=0.09
probe w16 xmin=29.75 xmax=30.25 ymin=2 ymax=2.25
