# Two waveguides 10 um apart with nothing between them. Neighbour at 10 um.
# Reference: the same mesh solved with a sparse direct solver in SciPy.
title No trench: the reference for this family
grid dx=0.25 dy=0.25
window width=80 ymin=-10 ymax=5
layer si -10 0
layer sio2 0 5
rect si -0.25 0.25 2 2.25
rect tin -1 1 4 4.25
heater h1 xmin=-1 xmax=1 ymin=4 ymax=4.25 power=0.1
probe wg1 xmin=-0.25 xmax=0.25 ymin=2 ymax=2.25
rect si 9.75 10.25 2 2.25
probe wg2 xmin=9.75 xmax=10.25 ymin=2 ymax=2.25
transient heater=h1 dt=1 steps=600
expect response wg1 h1 171.838116 1e-7
expect response wg2 h1 13.4208258 1e-7
expect pi_power wg1 h1 24.2476278 1e-7
expect peak 41.4465891 1e-7
expect balance 1e-9
expect cells 19200
expect tau wg1 9.6047019 1e-6
expect rise wg1 21.277831 1e-6
expect tau wg2 26.671872 1e-6
expect rise wg2 34.653735 1e-6
