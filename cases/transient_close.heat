# A closer heater shortens the delay.
# Reference: the same implicit Euler stepping with a sparse solver in SciPy.
title Step response with the heater 0.75 um above the waveguide
grid dx=0.25 dy=0.25
window width=60 ymin=-10 ymax=5
layer si -10 0
layer sio2 0 5
rect si -0.25 0.25 2 2.25
rect tin -1 1 3 3.25
heater h xmin=-1 xmax=1 ymin=3 ymax=3.25 power=0.1
probe wg xmin=-0.25 xmax=0.25 ymin=2 ymax=2.25
transient heater=h dt=0.5 steps=500
expect response wg h 204.280318 1e-7
expect pi_power wg h 20.3968092 1e-7
expect peak 32.557901 1e-7
expect balance 1e-9
expect cells 14400
expect tau wg 6.6211437 1e-6
expect rise wg 18.281202 1e-6
