# A thin buried oxide is fast and inefficient.
# Reference: the same implicit Euler stepping with a sparse solver in SciPy.
title Step response with 1 um of buried oxide
grid dx=0.25 dy=0.25
window width=60 ymin=-10 ymax=4
layer si -10 0
layer sio2 0 4
rect si -0.25 0.25 1 1.25
rect tin -1 1 3 3.25
heater h xmin=-1 xmax=1 ymin=3 ymax=3.25 power=0.1
probe wg xmin=-0.25 xmax=0.25 ymin=1 ymax=1.25
transient heater=h dt=0.25 steps=500
expect response wg h 109.834304 1e-7
expect pi_power wg h 37.9359317 1e-7
expect peak 36.2308433 1e-7
expect balance 1e-9
expect cells 13440
expect tau wg 6.3388666 1e-6
expect rise wg 13.547424 1e-6
